# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit it.

# ─── LLM provider (required) ──────────────────────────────────────────────
# The default provider. Options: "mistral" | "openai" | "groq" | "openrouter" | "gemini"
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest

# Set the API key matching the provider above.
# Get a free Mistral key (no card needed): https://console.mistral.ai
MISTRAL_API_KEY=

# Alternative providers — fill in if you switch LLM_PROVIDER:
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# ─── Web search fallback (optional) ───────────────────────────────────────
# Only needed if you want the corrective-RAG loop to fall back to web search
# when the grader marks retrieved passages insufficient.
# Get a free Tavily key (1000 searches/month free): https://tavily.com
TAVILY_API_KEY=

# ─── DOI lookup (optional) ────────────────────────────────────────────────
# Unpaywall asks for a real contact email per request. They use it to reach
# out if your usage misbehaves. Free, no key required.
# https://unpaywall.org
UNPAYWALL_EMAIL=
